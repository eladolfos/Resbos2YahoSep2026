	cd /mnt/home/fuyao3/pku_resbos/SourceCode/resbos2/build && $(MAKE) $(MAKESILENT) -f src/Utilities/CMakeFiles/ResbosUtilities.dir/build.make src/Utilities/CMakeFiles/ResbosUtilities.dir/loguru.cpp.o
.PHONY : loguru.cpp.o

loguru.i: loguru.cpp.i
.PHONY : loguru.i

# target to preprocess a source file
loguru.cpp.i:
	cd /mnt/home/fuyao3/pku_resbos/SourceCode/resbos2/build && $(MAKE) $(MAKESILENT) -f src/Utilities/CMakeFiles/ResbosUtilities.dir/build.make src/Utilities/CMakeFiles/ResbosUtilities.dir/loguru.cpp.i
.PHONY : loguru.cpp.i

loguru.s: loguru.cpp.s
.PHONY : loguru.s

# target to generate assembly for a file
loguru.cpp.s:
	cd /mnt/home/fuyao3/pku_resbos/SourceCode/resbos2/build && $(MAKE) $(MAKESILENT) -f src/Utilities/CMakeFiles/ResbosUtilities.dir/build.make src/Utilities/CMakeFiles/ResbosUtilities.dir/loguru.cpp.s
.PHONY : loguru.cpp.s

